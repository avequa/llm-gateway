# Скопируй в .env (он в .gitignore) и поправь под себя, docker compose читает .env сам

# папка с уже скачанными моделями Ollama на хосте; для установки Ollama в Linux/WSL как службы это путь ниже
# без этой строки модели хранятся в Docker volume ollama-models и скачиваются заново (make pull MODEL=...)
OLLAMA_MODELS_DIR=/usr/share/ollama/.ollama/models

# пароль администратора Grafana
GRAFANA_ADMIN_PASSWORD=admin
